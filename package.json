{
  "name": "megafighter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser fighting game in the spirit of Mortal Kombat, built with Three.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "sim": "esbuild src/dev/simulate.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/sim.mjs --log-level=warning && node node_modules/.cache/sim.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/three": "^0.180.0",
    "playwright": "^1.56.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.0"
  }
}
